{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/schemas/scientific-intelligence-v0.1-task.json",
  "title": "AXIOM Scientific Intelligence Benchmark Task",
  "type": "object",
  "required": ["task_id", "level", "prompt", "expected_concept", "forbidden_shortcut"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^sci-v0\\.1-l[1-8]-[0-9]{2}$"},
    "level": {"enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8"]},
    "prompt": {"type": "string", "minLength": 1},
    "expected_concept": {"type": "string", "minLength": 1},
    "forbidden_shortcut": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
