# ─────────────────────────────────────────────────────────────────────────────
# AXIOM Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AXIOM
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=false

# ── API Gateway ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# ── Authentication ────────────────────────────────────────────────────────────
# IMPORTANT: Change these in production!
# Generate with: openssl rand -hex 32
AXIOM_API_TOKEN=axiom-dev-token
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./axiom.db
DB_PATH=./axiom.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json (production) | console (local dev)
LOG_FORMAT=console

# ── Monitoring ────────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ── Lean 4 ───────────────────────────────────────────────────────────────────
LEAN_BIN_PATH=/usr/local/bin/lean
LEAN_OUTPUT_DIR=/tmp/axiom_proofs

# ── arXiv ────────────────────────────────────────────────────────────────────
ARXIV_BASE_URL=https://arxiv.org
ARXIV_E_PRINT_URL=https://arxiv.org/e-print
INGEST_TIMEOUT_SECONDS=30

# ── MCTS ─────────────────────────────────────────────────────────────────────
MCTS_MAX_ITERATIONS=1000
MCTS_EXPLORATION_WEIGHT=1.414

# ── Hypothesis Engine ─────────────────────────────────────────────────────────
HYP_MAX_HYPOTHESES_PER_RUN=5

# ── Self-Improvement ──────────────────────────────────────────────────────────
SIL_WORKSPACE_ROOT=.

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
