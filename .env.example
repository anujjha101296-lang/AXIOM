# ======================================================================
# AXIOM — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ======================================================================

# ── JWT / Auth ────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# ── LLM Provider ────────────────────────────────────────────────────
# Select: openai | gemini
# Leave unset to use mock-model (testing only)
DEFAULT_MODEL=gemini-1.5-pro
# DEFAULT_MODEL=gpt-4o

OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Embedding Provider ───────────────────────────────────────────────
# Select: openai | gemini | test
# EMBEDDING_PROVIDER=test → deterministic mock (no network, for CI)
# EMBEDDING_PROVIDER=openai → requires OPENAI_API_KEY
# EMBEDDING_PROVIDER=gemini → requires GEMINI_API_KEY
EMBEDDING_PROVIDER=test
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL=models/embedding-001

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./axiom.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/axiom

# ── Environment ──────────────────────────────────────────────────────
# test | development | production
ENVIRONMENT=development

# ── Live Provider Tests (optional) ──────────────────────────────────
# Set to true to run tests that call real LLM/embedding APIs
# Requires real API keys above. Will incur costs.
RUN_LIVE_PROVIDER_TESTS=false
